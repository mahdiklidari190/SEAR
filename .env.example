# SEAR Environment Configuration
# Copy this file to .env and fill in your credentials.

# Google Search Console (Optional)
GSC_CLIENT_ID=your_client_id_here
GSC_CLIENT_SECRET=your_client_secret_here
GSC_REFRESH_TOKEN=your_refresh_token_here
GSC_PROPERTY_URL=https://example.com/

# Google Analytics 4 (Optional)
GA4_CLIENT_ID=your_client_id_here
GA4_CLIENT_SECRET=your_client_secret_here
GA4_REFRESH_TOKEN=your_refresh_token_here
GA4_PROPERTY_ID=your_property_id_here

# Backlink APIs (Optional - Provide at least one)
AHREFS_API_KEY=
SEMRUSH_API_KEY=
MOZ_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Crawler Settings (Optional overrides)
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
MAX_PAGES=500
